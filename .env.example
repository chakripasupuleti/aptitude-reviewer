# Keep this file in the project, but do not put your real API key here.
# Copy this file to .env locally and add your actual key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use for LLM-assisted reasoning checks (OpenRouter model ID).
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# Google Sheets integration (optional — enables persistent run history across sessions).
# See the Dashboard → Setup Guide in the web app for step-by-step instructions.
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_PATH=credentials.json
